+// written at all, pperr clean, an entirely stale `out`. The 64-bit
+// intermediate plus the cap cannot produce that.
+__device__ __forceinline__ int k0p6_m24_round_up_sat(int n, int grain,
+                                                     int cap) {
+  if (cap <= 0) return 0;
+  if (n <= 0) return 0;
+  if (n >= cap) return cap;
